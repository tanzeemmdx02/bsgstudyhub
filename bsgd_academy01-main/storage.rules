rules_version = '2';

// Deny by default. Only signed-in users may read files; only staff
// (admins/teachers, per users/{uid}.role or teachers/{uid}) may upload.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isStaff() {
      return signedIn() && (
        firestore.exists(/databases/(default)/documents/teachers/$(request.auth.uid)) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         userDoc().role in ['admin','teacher']));
    }

    match /{allPaths=**} {
      allow read: if signedIn();
      allow write: if isStaff()
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
